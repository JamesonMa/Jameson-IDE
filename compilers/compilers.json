{
  "cpp": {
    "name": "C++",
    "command": "c++",
    "args": ["-std=gnu++17", "-o", "${outputDir}/${fileBasenameNoExt}", "${file}"],
    "run": "${outputDir}/${fileBasenameNoExt}"
  },
  "c": {
    "name": "C",
    "command": "cc",
    "args": ["-std=gnu11", "-o", "${outputDir}/${fileBasenameNoExt}", "${file}"],
    "run": "${outputDir}/${fileBasenameNoExt}"
  },
  "python": {
    "name": "Python",
    "command": "python3",
    "args": ["${file}"]
  },
  "javascript": {
    "name": "JavaScript (Node.js)",
    "command": "node",
    "args": ["${file}"]
  },
  "r": {
    "name": "R",
    "command": "Rscript",
    "args": ["${file}"]
  }
}

{
  "cpp": {
    "name": "C++",
    "command": "compilers/mingw/bin/g++.exe",
    "args": ["-o", "${outputDir}/${fileBasenameNoExt}.exe", "${file}"],
    "run": "${outputDir}/${fileBasenameNoExt}.exe"
  },
  "c": {
    "name": "C",
    "command": "compilers/mingw/bin/gcc.exe",
    "args": ["-o", "${outputDir}/${fileBasenameNoExt}.exe", "${file}"],
    "run": "${outputDir}/${fileBasenameNoExt}.exe"
  },
  "python": {
    "name": "Python",
    "command": "compilers/python/python.exe",
    "args": ["${file}"]
  },
  "javascript": {
    "name": "JavaScript (Node.js)",
    "command": "compilers/node/node.exe",
    "args": ["${file}"]
  },
  "r": {
    "name": "R",
    "command": "compilers/r/bin/x64/Rscript.exe",
    "args": ["${file}"]
  }
}
